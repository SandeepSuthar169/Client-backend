# ############################ PORT #############################################
PORT=your_Port
NODE_ENV=example-1

# ############################ DATABASE URL #####################################
DATABASE_URL=your_PostgreSQL_Connection_URL

# ############################ SESSION #####################################
SESSION_SECRET=my_super_long_session_secret_change_me
SESSION_MAX_AGE=86400000

# ############################ CLOUDINARY ######################################
CLOUDINARY_CLOUD_NAME=your_Cloudinary_name
CLOUDINARY_API_KEY=your_API-Key_name
CLOUDINARY_API_SECRET=-your_API-SECRET
CLOUDINARY_URL=cloudinary://<CLOUDINARY_API_KEY>:<CLOUDINARY_API_SECRET>@<example>